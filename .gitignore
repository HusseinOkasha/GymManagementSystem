## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
out/
[Bb]uild/

# Visual Studio cache/options
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.DotSettings.user

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.snupkg

# Logs
*.log

# Generated files
*.g.dart

# Publish output
publish/
*.Publish.xml

# Azure
*.azurePubxml

# Others
*.tmp
*.temp
*.bak

# Configuration (if you don’t want to commit secrets)
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings

# OS-specific
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
